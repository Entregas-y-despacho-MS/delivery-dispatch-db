# Plantilla de PRODUCCIÓN (AWS EC2). Usado por los scripts nativos (npm run migrate / rollback)
# corriendo con Node directo en la instancia EC2 (no dentro de un contenedor) — DB_HOST=localhost
# asume que el contenedor `db` publica su puerto en 127.0.0.1:5432, igual que en desarrollo (ver
# docker-compose.prod.yml de la raíz). Normalmente no hace falta correr migrate a mano en el
# primer despliegue: Postgres carga el schema solo, desde cero, la primera vez que arranca con un
# volumen vacío (ver Dockerfile de este repo) — esto es solo para aplicar migraciones nuevas
# después, contra una base ya corriendo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery_dispatch_db
DB_USER=postgres
DB_PASSWORD=postgres

# Mismas credenciales, con los nombres que espera la imagen oficial de postgres — los usa el
# servicio `db` de docker-compose.prod.yml (vía env_file) para inicializar el contenedor. Deben
# tener el mismo valor real que arriba.
POSTGRES_DB=delivery_dispatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
