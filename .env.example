# Usado por los scripts nativos de este proyecto (npm run migrate / rollback), corriendo
# con Node instalado directo en el host — no dentro de un contenedor. DB_HOST=localhost
# asume que el contenedor `db` publica su puerto en 127.0.0.1:5432 (ver docker-compose.yml
# de la raíz, delivery-dispatch-ms/).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# Mismas credenciales, con los nombres que espera la imagen oficial de postgres. Los usa
# el servicio `db` del docker-compose.yml de la raíz (vía env_file) para inicializar el
# contenedor — deben tener el mismo valor real que DB_NAME/DB_USER/DB_PASSWORD arriba.
POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
